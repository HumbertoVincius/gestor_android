<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Metas"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/widget_month_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Janeiro 2024"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E3F2FD"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Despesas"
                android:textSize="10sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/widget_total_expenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metas"
                android:textSize="10sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/widget_total_goals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- Cards de Categorias (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Card Categoria 1 -->
            <LinearLayout
                android:id="@+id/widget_category_card_1"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E3F2FD"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_category_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_value_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R$ 0 / R$ 0"
                    android:textSize="9sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_percentage_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Card Categoria 2 -->
            <LinearLayout
                android:id="@+id/widget_category_card_2"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E3F2FD"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_category_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_value_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R$ 0 / R$ 0"
                    android:textSize="9sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_percentage_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Card Categoria 3 -->
            <LinearLayout
                android:id="@+id/widget_category_card_3"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E3F2FD"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_category_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_value_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R$ 0 / R$ 0"
                    android:textSize="9sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_percentage_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Card Categoria 4 -->
            <LinearLayout
                android:id="@+id/widget_category_card_4"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E3F2FD"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_category_name_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_value_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R$ 0 / R$ 0"
                    android:textSize="9sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_percentage_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Card Categoria 5 -->
            <LinearLayout
                android:id="@+id/widget_category_card_5"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E3F2FD"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_category_name_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_value_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R$ 0 / R$ 0"
                    android:textSize="9sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/widget_category_percentage_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>

